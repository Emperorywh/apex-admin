# Apex Admin .dockerignore — SPEC 26.2: 镜像不包含开发密钥和无关文件.
#
# 排除规则按类别组织，确保镜像只包含生产运行所需文件。

# ── 版本控制 ──────────────────────────────────────────────────────────────
.git
.gitignore
.github

# ── 开发密钥与敏感配置（SPEC 26.2: 镜像不含开发密钥）─────────────────────
.env
.env.*
*.pem
*.key
*.crt
*.p12

# ── 测试与开发依赖 ────────────────────────────────────────────────────────
tests/
docs/
scripts/

# ── 构建产物与缓存 ────────────────────────────────────────────────────────
.venv/
.runtime/
.generated/
.coverage
htmlcov/
coverage.xml
coverage.json
__pycache__/
*.pyc
*.pyo

# ── IDE 与编辑器 ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── 操作系统 ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── 容器与部署（避免嵌套构建上下文）────────────────────────────────────────
deploy/
Dockerfile
.dockerignore
docker-compose*.yml

# ── 数据目录（运行时通过卷挂载）───────────────────────────────────────────
data/

# ── CI / Agent 元数据 ────────────────────────────────────────────────────
.apex-coding-agent/

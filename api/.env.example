NODE_ENV=development
HTTP_HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://runtime_user:change-me@localhost:5432/apex_admin
MIGRATION_DATABASE_URL=postgresql://migration_user:change-me@localhost:5432/apex_admin
JWT_ACCESS_SECRET_BASE64=replace-with-base64-encoded-32-byte-random-secret
JWT_ISSUER=apex-admin
JWT_ACCESS_AUDIENCE=apex-admin-web
JWT_ACCESS_TTL_SECONDS=900
REFRESH_SESSION_TTL_SECONDS=604800
REFRESH_REUSE_GRACE_SECONDS=5
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
ARGON2_MAX_CONCURRENCY=4
RATE_LIMIT_LOGIN_PER_IP=10
RATE_LIMIT_LOGIN_PER_EMAIL=5
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=https://admin.apex.local
TRUST_PROXY_HOPS=0
COOKIE_SECURE=false
DATABASE_POOL_MAX=10
DATABASE_POOL_CONNECT_TIMEOUT_MS=5000
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_TRANSACTION_MAX_WAIT_MS=2000
DATABASE_TRANSACTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=4000
DATABASE_LOCK_TIMEOUT_MS=1500
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=5000
SUPER_ADMIN_EMAIL=admin@apex.local
SUPER_ADMIN_PASSWORD=replace-with-a-unique-long-bootstrap-password

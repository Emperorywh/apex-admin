[importlinter]
root_package = app

# ---------------------------------------------------------------------------
# Layered architecture dependency rules (SPEC 5.2)
#
# Compile-time dependency direction:
#   API  -----------------> Application -----------------> Domain
#   Infrastructure -------> Application / Domain defined Port
#   Composition Root -----> API + Application + Infrastructure
#
# Layers listed from highest to lowest. Higher layers may depend on lower
# layers; lower layers must not depend on higher layers.
#
# Business modules (app.modules.<name>) implement the full layered
# architecture within themselves (Router -> Application -> Domain -> Port ->
# Infrastructure Adapter). Their internal subpackages span multiple
# architectural layers. The ignore_imports entries below allow example
# module subpackages to reference the core framework layers they need
# (api schemas, errors, events, infrastructure adapters). The developer
# guide documents the expected internal layering for each module.
# ---------------------------------------------------------------------------
[importlinter:contract:layered-architecture]
name = Layered architecture dependency rules (SPEC 5.2)
type = layers
layers =
    app.cli
    app.app
    app.lifespan
    app.composition_root
    app.api
    app.logging
    app.tasks
    app.middleware
    app.health.routes
    app.infrastructure
    app.context
    app.errors
    app.config
    app.events
    app.modules
    app.ports
    app.health.providers
ignore_imports =
    app.modules.example.domain.events -> app.events.base
    app.modules.example.application.service -> app.events.dispatcher
    app.modules.example.application.service -> app.errors
    app.modules.example.application.schemas -> app.api.schemas
    app.modules.example.infrastructure.event_handlers -> app.events.base
    app.modules.example.infrastructure.unit_of_work -> app.infrastructure.database.unit_of_work
    app.modules.example.infrastructure.wiring -> app.events.base
    app.modules.example.infrastructure.wiring -> app.events.dispatcher
    app.modules.example.infrastructure.wiring -> app.events.registry
    app.modules.example.routes -> app.api.pagination
    app.modules.example.routes -> app.api.schemas
    app.modules.example.routes -> app.infrastructure.database.db_pool_provider
    app.modules.user.domain.events -> app.events.base
    app.modules.user.application.service -> app.events.dispatcher
    app.modules.user.application.service -> app.errors
    app.modules.user.application.schemas -> app.api.schemas
    app.modules.user.infrastructure.event_handlers -> app.events.base
    app.modules.user.infrastructure.unit_of_work -> app.infrastructure.database.unit_of_work
    app.modules.user.infrastructure.wiring -> app.events.base
    app.modules.user.infrastructure.wiring -> app.events.dispatcher
    app.modules.user.infrastructure.wiring -> app.events.registry
    app.modules.user.routes -> app.api.pagination
    app.modules.auth.domain.events -> app.events.base
    app.modules.auth.application.service -> app.events.dispatcher
    app.modules.auth.application.service -> app.errors
    app.modules.auth.application.schemas -> app.api.schemas
    app.modules.auth.infrastructure.event_handlers -> app.events.base
    app.modules.auth.infrastructure.unit_of_work -> app.infrastructure.database.unit_of_work
    app.modules.auth.infrastructure.session_lifecycle -> app.infrastructure.database.unit_of_work
    app.modules.auth.infrastructure.wiring -> app.config.settings
    app.modules.auth.infrastructure.wiring -> app.events.base
    app.modules.auth.infrastructure.wiring -> app.events.dispatcher
    app.modules.auth.infrastructure.wiring -> app.events.registry
    app.modules.auth.routes -> app.config.settings
    app.modules.auth.middleware.origin -> app.config.settings
    app.modules.rbac.domain.events -> app.events.base
    app.modules.rbac.application.service -> app.events.dispatcher
    app.modules.rbac.application.service -> app.errors
    app.modules.rbac.application.schemas -> app.api.schemas
    app.modules.rbac.infrastructure.event_handlers -> app.events.base
    app.modules.rbac.infrastructure.unit_of_work -> app.infrastructure.database.unit_of_work
    app.modules.rbac.infrastructure.wiring -> app.events.base
    app.modules.rbac.infrastructure.wiring -> app.events.dispatcher
    app.modules.rbac.infrastructure.wiring -> app.events.registry
    app.modules.rbac.infrastructure.wiring -> app.modules.user.application.port
    app.modules.rbac.infrastructure.wiring -> app.modules.user.domain.model
    app.modules.rbac.infrastructure.wiring -> app.modules.user.infrastructure.repository
    app.modules.rbac.application.permission_sync -> app.modules.contract
    app.modules.rbac.routes -> app.api.pagination
    app.modules.rbac.dependencies -> app.modules.auth.application.port
    app.modules.rbac.dependencies -> app.modules.auth.application.service
    app.modules.rbac.dependencies -> app.modules.auth.infrastructure.wiring
    app.modules.rbac.dependencies -> app.config.settings
    app.modules.audit.domain.model -> app.ports.audit
    app.modules.audit.domain.diff -> app.ports.audit
    app.modules.audit.infrastructure.models -> app.ports.audit
    app.modules.audit.infrastructure.models -> app.modules.audit.domain.model
    app.modules.audit.infrastructure.repository -> app.modules.audit.domain.model
    app.modules.audit.infrastructure.repository -> app.modules.audit.infrastructure.models
    app.modules.audit.infrastructure.unit_of_work -> app.infrastructure.database.unit_of_work
    app.modules.audit.infrastructure.unit_of_work -> app.modules.audit.infrastructure.repository
    app.modules.audit.infrastructure.audit_port -> app.infrastructure.database.unit_of_work
    app.modules.audit.infrastructure.audit_port -> app.modules.audit.domain.model
    app.modules.audit.infrastructure.audit_port -> app.modules.audit.infrastructure.repository
    app.modules.audit.infrastructure.audit_port -> app.ports.audit

# ---------------------------------------------------------------------------
# API layer must not depend on Infrastructure layer (SPEC 5.2, 5.6)
#
# Router must only receive Use Case; must not receive AsyncSession,
# Repository or commit interface. The layers contract allows API (above
# Infrastructure) to reference Infrastructure; this forbidden contract
# explicitly blocks that direction.
# ---------------------------------------------------------------------------
[importlinter:contract:forbid-api-to-infra]
name = API layer forbidden from depending on Infrastructure (SPEC 5.2)
type = forbidden
source_modules =
    app.health.routes
    app.middleware
    app.api
forbidden_modules =
    app.infrastructure

          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "每页条数，1 至 100",
              "default": 20,
              "title": "Page Size"
            },
            "description": "每页条数，1 至 100"
          }

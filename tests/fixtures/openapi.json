  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "type": "string",
            "minLength": 1,
            "title": "Current Password",
            "description": "当前密码"
          },
          "new_password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "New Password",
            "description": "新明文密码，12–128 个 Unicode 字符"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "title": "ChangePasswordRequest",
        "description": "用户自助修改密码请求 Schema（SPEC §11.1、§23.2）。\n\n需提供当前密码和新密码。新密码长度以 Unicode 字符计数：12–128。\n\nAttributes:\n    current_password: 当前明文密码\n    new_password: 新明文密码，12–128 个 Unicode 字符"
      },
      "CreateExampleRequest": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CreateExampleRequest",
        "description": "创建示例项目请求 Schema（SPEC §9.2）。\n\nAttributes:\n    name: 示例项目名称，非空且不超过 100 字符"
      },
      "CreateExampleResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "CreateExampleResponse",
        "description": "创建示例项目成功响应（SPEC §9.3：201 返回资源 Schema）。"
      },
      "CreateUserRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 50,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_-]+$",
            "title": "Username",
            "description": "用户名，3–50 个字符，字母数字下划线连字符"
          },
          "display_name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Display Name",
            "description": "显示名称"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "description": "明文密码，12–128 个 Unicode 字符"
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone",
            "description": "手机号（可选）"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "description": "邮箱（可选）"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "display_name",
          "password"
        ],
        "title": "CreateUserRequest",
        "description": "创建用户请求 Schema（SPEC §9.2、§23.2）。\n\n密码长度以 Unicode 字符计数：最小 12，最大 128。\n超长密码直接拒绝（不截断），符合 SPEC §23.2 要求。\n\nAttributes:\n    username: 用户名，3–50 个字符，字母数字下划线连字符\n    display_name: 显示名称，1–100 个字符\n    password: 明文密码，12–128 个 Unicode 字符\n    phone: 手机号（可选），最长 20 个字符\n    email: 邮箱（可选），最长 255 个字符"
      },
      "ExampleResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "created_at"
        ],
        "title": "ExampleResponse",
        "description": "示例项目响应 Schema（SPEC §9.3）。\n\n响应直接返回资源 Schema，不使用 ``{code, message, data}`` 信封。\n时间字段使用带时区的 ISO 8601 字符串（SPEC §9.3、§6.3）。\n\n``from_attributes=True`` 允许从领域实体（dataclass）直接构造响应。\n\nAttributes:\n    id: 实体 UUID\n    name: 名称\n    created_at: 创建时间（UTC）"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Page_ExampleResponse_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ExampleResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "pages": {
            "type": "integer",
            "title": "Pages"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "pages"
        ],
        "title": "Page[ExampleResponse]"
      },
      "Page_UserResponse_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/UserResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "pages": {
            "type": "integer",
            "title": "Pages"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "pages"
        ],
        "title": "Page[UserResponse]"
      },
      "ResetPasswordRequest": {

{
  "openapi": "3.1.0",
  "info": {
    "title": "Apex Admin",
    "summary": "FastAPI 后台管理系统 API 基座",
    "version": "0.1.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "存活检查",
        "description": "存活检查（SPEC §6.2）。\n\n只验证进程事件循环可响应，数据库不可用时仍返回 HTTP 200。",
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Live Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "就绪检查",
        "description": "就绪检查（SPEC §6.2）。\n\n通过 provider 接口检查 DB 连接和 Alembic revision 一致性。\n任一条件失败时返回 HTTP 503；恢复后无需重启进程即可重新就绪。\n\n返回内容不泄露敏感配置。",
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Ready Health Ready Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/examples": {
      "post": {
        "tags": [
          "examples"
        ],
        "summary": "创建示例项目",
        "description": "创建一个新的示例项目。此端点演示 Router → Use Case → Domain Policy → Repository → Database 的完整调用流，包含领域事件发布和事务提交。成功返回 HTTP 201 和创建的资源。",
        "operationId": "create_example_api_v1_examples_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateExampleRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateExampleResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "examples"
        ],
        "summary": "查询示例项目列表",
        "description": "分页查询全部示例项目。此端点演示分页参数解析、Repository 查询和 Page 响应模式。响应使用标准分页结构 {items, total, page, page_size, pages}。",
        "operationId": "list_examples_api_v1_examples_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "页码，从 1 开始",
              "default": 1,
              "title": "Page"
            },
            "description": "页码，从 1 开始"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "每页条数，1 至 100",
              "default": 20,
              "title": "Page Size"
            },
            "description": "每页条数，1 至 100"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_ExampleResponse_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },

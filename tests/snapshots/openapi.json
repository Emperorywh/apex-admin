  "components": {
    "schemas": {
      "ExampleItemCreateRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "description": "条目名称"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000

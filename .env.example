# =============================================================================
# 环境变量示例
# 复制为 .env 并填入真实值；生产环境通过部署环境管理，禁止提交真实密钥。
# 所有变量使用 APEX_ 前缀（SPEC 7.1），由 pydantic-settings 自动加载。
# =============================================================================

# ---- 运行环境 ----
# development | testing | production
APEX_ENVIRONMENT=development

# 应用名称（用于 meta 端点、日志、OpenAPI 文档标识）
APEX_APP_NAME=apex-admin

# 应用版本
APEX_APP_VERSION=0.1.0

# API 统一前缀（SPEC 9.1）
APEX_API_PREFIX=/api/v1

# ---- 数据库 ----
# SQLAlchemy 异步 URL，驱动固定使用 psycopg
APEX_DATABASE_URL=postgresql+psycopg://xxxxxx:xxxxxx@47.109.194.193:5432/xxxxxx

# ---- 安全密钥（SPEC 12.2）----
# Access Token HMAC 密钥（至少 256 bit 熵 / 32 字节，生产必须替换）
APEX_ACCESS_TOKEN_HMAC_KEY=change-me-access-token-hmac-key-min-32-bytes

# Refresh Token HMAC 密钥（至少 256 bit 熵 / 32 字节，与 Access Token 密钥不同）
APEX_REFRESH_TOKEN_HMAC_KEY=change-me-refresh-token-hmac-key-min32-bytes

# ---- 日志 ----
# 日志级别
APEX_LOG_LEVEL=INFO

# ============================================================================
# Apex Admin 部署配置示例
# 复制本文件为 .env 并填入真实值，禁止提交真实密钥到版本控制。
# ============================================================================

# ---- 应用环境 ----
# 运行环境：development / testing / production
# 生产环境会执行额外的安全校验（拒绝弱密钥和开发默认 CORS）
APP_ENV=development

# ---- 数据库 ----
# PostgreSQL 连接 URL
# 格式：postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://apex:changeme@localhost:5432/apex_admin

# 数据库连接池参数（SPEC §26.1）
# 连接池常驻连接数，默认 5
DB_POOL_SIZE=5
# 连接池溢出连接数，峰值连接数 = DB_POOL_SIZE + DB_MAX_OVERFLOW，默认 5
DB_MAX_OVERFLOW=5

# ---- Token 摘要密钥（SPEC §12.2）----
# Access Token HMAC-SHA-256 摘要密钥
# 要求：至少 256 bit 熵（32 字节），建议使用 openssl rand -hex 32 生成
ACCESS_TOKEN_HMAC_KEY=

# Refresh Token HMAC-SHA-256 摘要密钥
# 要求：至少 256 bit 熵，且必须与 ACCESS_TOKEN_HMAC_KEY 不同
REFRESH_TOKEN_HMAC_KEY=

# ---- 敏感配置加密（SPEC §23.2）----
# 系统配置中敏感字段的加密密钥
# 要求：与 Token 摘要密钥彼此独立
CONFIG_ENCRYPTION_KEY=

# ---- 文件存储（SPEC §19.1）----
# 本地文件存储根目录的绝对路径
# 不得位于 Web Root，应用不得跟随其中的符号链接
FILE_STORAGE_ROOT=./data/files

# ---- CORS 允许来源（SPEC §23.1）----
# CORS 允许来源白名单，JSON 数组格式
# 开发默认为 ["http://localhost:3000"]，生产环境必须显式配置
ALLOWED_ORIGINS=["http://localhost:3000"]

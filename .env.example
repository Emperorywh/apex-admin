# =============================================================================
# 环境变量示例
# 复制为 .env 并填入真实值；生产环境通过部署环境管理，禁止提交真实密钥。
# =============================================================================

# ---- 运行环境 ----
# development | testing | production
APP_ENV=development

# 应用名称（用于日志、健康检查和 OpenAPI 文档标识）
APP_NAME=apex-admin

# API 版本前缀
API_PREFIX=/api/v1

# ---- 数据库 ----
# SQLAlchemy 异步 URL，驱动固定使用 psycopg
DATABASE_URL=postgresql+psycopg://apex:apex_password@localhost:5432/apex

# 连接池大小（每 Worker）
DB_POOL_SIZE=5
# 连接池溢出上限（每 Worker）
DB_MAX_OVERFLOW=5
# 连接超时（秒）
DB_POOL_TIMEOUT=30
# 连接回收周期（秒）
DB_POOL_RECYCLE=3600

# ---- 安全密钥 ----
# Access Token HMAC 密钥（至少 256 bit 熵，生产必须替换）
ACCESS_TOKEN_HMAC_KEY=change-me-access-token-hmac-key

# Refresh Token HMAC 密钥（至少 256 bit 熵，与 Access Token 密钥不同）
REFRESH_TOKEN_HMAC_KEY=change-me-refresh-token-hmac-key

# 敏感配置加密密钥（至少 256 bit 熵）
SECRET_CONFIG_KEY=change-me-secret-config-key

# ---- CORS ----
# 允许的前端来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000

# ---- 文件存储 ----
# 本地文件存储根目录
FILE_STORAGE_ROOT=./.runtime/files

# ---- 日志 ----
# 日志级别
LOG_LEVEL=INFO

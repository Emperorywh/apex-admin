# Apex Admin 生产部署环境变量模板 — SPEC 7.1 / 26.1 / 26.2.
#
# 复制本文件为 .env.production 并填写真实值:
#   cp deploy/.env.example deploy/.env.production
#
# ⚠️ .env.production 不得提交到版本控制（.gitignore 已排除 .env.*）。

# ── 应用版本（SPEC 26.2: 镜像版本可追踪到代码版本）─────────────────────────
# 通常由 CI 注入: APP_VERSION=$(git describe --tags) GIT_SHA=$(git rev-parse --short HEAD)
APP_VERSION=0.1.0
GIT_SHA=unknown

# ── PostgreSQL（SPEC 26.1）─────────────────────────────────────────────────
# 生产环境必须使用强密码
POSTGRES_PASSWORD=change-me-to-a-strong-password

# ── Nginx 端口（SPEC 26.3）─────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Token HMAC 摘要密钥（SPEC 12.2）────────────────────────────────────────
# 每把密钥 ≥ 32 字节（256 bit 熵），两把密钥不得相同。
# 生产环境必须通过环境变量设置。
APEX_ACCESS_TOKEN_HMAC_KEY=
APEX_REFRESH_TOKEN_HMAC_KEY=

# ── 敏感配置加密密钥（SPEC 16.1 / 23.2）────────────────────────────────────
# Fernet 格式（url-safe base64 编码的 32 字节）。
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APEX_SYSCONFIG_ENCRYPTION_KEY=

# ── HTTP 安全（SPEC 23.1 / 26.3）───────────────────────────────────────────
# CORS 来源白名单（禁止通配 *）
APEX_ALLOWED_ORIGINS=https://admin.example.com
# 可信 Host 白名单（禁止通配 *）
APEX_TRUSTED_HOSTS=admin.example.com
# 可信代理 IP（Nginx 容器地址或 Docker 内网网段）
APEX_TRUSTED_PROXIES=nginx

# ── 运行指标（SPEC 24.2）───────────────────────────────────────────────────
# /metrics 端点访问令牌
APEX_METRICS_TOKEN=
